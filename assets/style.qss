* { font-size: 10.5pt; }
QFrame#Card { border-radius: 14px; border: 1px solid {border}; background: {surface}; }
QLabel#Title { font-size: 19pt; font-weight: 700; }
QLabel#SectionTitle { font-size: 12pt; font-weight: 700; }
QPushButton { border-radius: 9px; padding: 7px 14px; }
QPushButton#Primary { border-radius: 9px; padding: 7px 18px; }
QListWidget#NavList { background: {surface2}; border-right: 1px solid {border}; padding: 10px 8px; }
QListWidget#NavList::item { padding: 10px 12px; border-radius: 9px; margin: 2px 0; }
QListWidget#NavList::item:selected { background: {surface}; color: {accent}; border: 1px solid {border}; border-left: 3px solid {accent}; }
QTableView, QTableWidget { border-radius: 10px; }
QHeaderView::section { background: {surface2}; color: {muted}; font-weight: 700; padding: 8px 6px; }
QComboBox, QLineEdit, QDateEdit, QPlainTextEdit { border-radius: 8px; }
